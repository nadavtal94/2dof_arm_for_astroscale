<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="finger_radius" value="${gripper_width / 4}"/>
  <xacro:property name="finger_length" value="${gripper_depth * 3}"/>
  <xacro:property name="finger_offset" value="${gripper_width / 4}"/>

  <!-- Joint 3 (Fixed - Attaches Gripper Base to Link 2) -->
  <joint name="joint3" type="fixed">
      <parent link="link2"/>
      <child link="gripper_base"/>
      <origin xyz="0 0 ${link2_length + (gripper_height / 2)}" rpy="0 0 0"/>
  </joint>

  <!-- Gripper Base -->
  <link name="gripper_base">
    <visual>
      <geometry>
        <box size="${gripper_width} ${gripper_depth} ${gripper_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="green" />
    </visual>
    <collision>
      <geometry>
        <box size="${gripper_width} ${gripper_depth} ${gripper_height}" />
      </geometry>
       <origin xyz="0 0 0" rpy="0 0 0"/>
      </collision>
      <xacro:box_inertia m="5.0" l="${gripper_width}" w="${gripper_depth}" h="${gripper_height}" 
                        xyz="0 0 0" rpy="0 0 0" />
  
    
  </link>

  <!-- Left Gripper Finger -->
  <joint name="left_gripper_joint" type="revolute">
    <parent link="gripper_base"/>
    <child link="left_gripper"/>
    <origin xyz="-${finger_radius} 0 ${finger_offset}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="0.0" effort="5.0" velocity="1.0"/>
  </joint>

  <link name="left_gripper">
    <visual>
      <geometry>
        <cylinder radius="${finger_radius}" length="${finger_length}"/>
      </geometry>
      <origin xyz="0 0 ${finger_length/2}" rpy="0 0 0"/>
      <material name="gray" />
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${finger_radius}" length="${finger_length}"/>
      </geometry>
    <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
    </collision>
    <xacro:cylinder_inertia m="0.1" r="${finger_radius}" h="${finger_length}"
                            xyz="0 0 0" rpy="0 0 0" />
  </link>

  <!-- Right Gripper Finger -->
  <joint name="right_gripper_joint" type="revolute">
    <parent link="gripper_base"/>
    <child link="right_gripper"/>
    <origin xyz="${finger_radius} 0 ${finger_offset}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="1.5708" effort="5.0" velocity="1.0"/>
  </joint>

  <link name="right_gripper">
    <visual>
      <geometry>
        <cylinder radius="${finger_radius}" length="${finger_length}"/>
      </geometry>
      <origin xyz="0 0 ${finger_length/2}" rpy="0 0 0"/>
      <material name="gray" />
    </visual>
     <collision>
      <geometry>
        <cylinder radius="${finger_radius}" length="${finger_length}"/>
      </geometry>
    <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
    </collision>
    <xacro:cylinder_inertia m="0.1" r="${finger_radius}" h="${finger_length}"
                            xyz="0 0 0" rpy="0 0 0" />
  </link>

</robot>

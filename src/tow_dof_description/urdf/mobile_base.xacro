<?xml version="1.0"?>
<robot name="2dof_manipulator" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Define Properties -->
    <xacro:property name="base_radius" value="0.1"/>
    <xacro:property name="base_height" value="1"/>
    <xacro:property name="link1_radius" value="0.1"/>
    <xacro:property name="link1_length" value="1"/>
    <xacro:property name="link2_radius" value="0.1"/>
    <xacro:property name="link2_length" value="1"/>
    <xacro:property name="gripper_width" value="0.2"/>  
    <xacro:property name="gripper_height" value="0.1"/> 
    <xacro:property name="gripper_depth" value="0.1"/>  


    <!-- Base Link -->
    <link name="base_link" />
         
    <!-- Joint 1 (Revolute - Rotates around Z) -->
    <joint name="joint1" type="revolute">
        <parent link="base_link"/>
        <child link="link1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/> <!-- Rotation around Z-axis -->
        <limit lower="${-pi}" upper="${pi}"  effort="10.0" velocity="1.0"/>
    </joint>

    <!-- Link 1 -->
    <link name="link1">
        <visual>
            <geometry>
                <cylinder radius="${link1_radius}" length="${link1_length}"/>
            </geometry>
            <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0"/>
            <material name="red" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${link1_radius}" length="${link1_length}"/>
            </geometry>
            <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0"/>
        </collision>
        <xacro:cylinder_inertia m="0.4" r="${link1_radius}" h="${link1_length}"
                                 xyz="0 0 0" rpy="0 0 0" />
    </link>

    <!-- Joint 2 (Revolute - Rotates around Y) -->
    <joint name="joint2" type="revolute">
        <parent link="link1"/>
        <child link="link2"/>
        <origin xyz="${link1_radius + link2_radius} 0 ${link1_length}" rpy="0 0 0"/>
        <axis xyz="1 0 0"/> <!-- Rotation around Y-axis -->
        <limit lower="${-pi/2}"  upper="${pi/2}"  effort="10.0" velocity="1.0"/>
    </joint>

    <!-- Link 2 -->
    <link name="link2">
        <visual>
            <geometry>
                <cylinder radius="${link2_radius}" length="${link2_length}"/>
            </geometry>
            <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${link2_radius}" length="${link2_length}"/>
            </geometry>
            <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
        </collision>
        <xacro:cylinder_inertia m="0.3" r="${link2_radius}" h="${link2_length}"
                                 xyz="0 0 0" rpy="0 0 0" />
    </link>

    

</robot> 
<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tow_dof">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import tow_dof urdf file -->
    <xacro:include filename="$(find tow_dof_description)/urdf/dof2.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="tow_dof.ros2_control.xacro" />


    <xacro:tow_dof_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
